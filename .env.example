# ARSENAL NOIR — variables d'environnement
#
# Copie ce fichier vers .env.local et renseigne les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).
#
# L'application refuse de démarrer si une de ces clés manque : c'est voulu.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe -----------------------------------------------------------------
# Tableau de bord Stripe > Développeurs > Clés API (mode test au départ).
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Fourni par `stripe listen` en local, ou par le tableau de bord en production.
STRIPE_WEBHOOK_SECRET=whsec_

# --- Supabase ---------------------------------------------------------------
# Paramètres du projet > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SECRET ABSOLU : contourne toutes les règles RLS. Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=re_

# --- Signature des liens de téléchargement ----------------------------------
# 32 octets aléatoires. Générer avec : openssl rand -base64 32
# Changer cette valeur invalide immédiatement tous les liens déjà envoyés.
DOWNLOAD_TOKEN_SECRET=
